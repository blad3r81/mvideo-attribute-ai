# Скопируйте значения в окружение процесса. Ключи не добавляйте в Git.
PORT=4174
HOST=127.0.0.1
# DEMO_MODE=1 включает только ограниченный /api/preview. /api/extract всегда требует API_TOKEN.
DEMO_MODE=0
API_TOKEN=replace-with-a-long-random-secret
DECISION_POLICY_PATH=
LEXICON_PATH=
# Необязательная LLM: вызывается только при use_llm=true.
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=
LLM_AUTO_REVIEW=0
LLM_TIMEOUT_MS=8000
LLM_DAILY_LIMIT=60
# Таймаут отсутствия прогресса дочернего процесса при пакетном прогоне, секунды.
BATCH_IDLE_TIMEOUT_SEC=300
# Если каталог другого набора данных подготовлен в том же формате:
CATALOG_SCHEMA_PATH=
DEMO_CARDS_PATH=
DATASET_STATS_PATH=
